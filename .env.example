# Copy this file to .env and fill in your own values.
# cp .env.example .env

# --- Database (docker-compose.yml provisions this Postgres container for you) ---
# Letters and numbers only. Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Auth ---
# 32+ random characters. Generate: openssl rand -base64 48
JWT_SECRET=
# How long a sign-in lasts before needing to sign in again (days). Default 60.
SESSION_DAYS=60

# First account, created only when the database has no users yet.
# You'll be asked to choose your own password at first sign-in.
ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=

# --- Networking ---
# Host port the app is published on.
APP_PORT=3000
# Set to true if the app sits behind a reverse proxy (nginx, Traefik, Dokploy, Caddy profile below).
TRUST_PROXY=false
# Used for backup timestamps and the Caddy HTTPS profile's certificate renewal schedule.
TZ=Europe/London

# --- HTTPS (only needed with `docker compose --profile https up`) ---
# Public domain name the Caddy service will get a Let's Encrypt certificate for.
DOMAIN=

# --- Backups ---
# local, s3, or both
BACKUP_TARGET=local
# Daily time (24h, uses TZ above) or "off" to disable the schedule.
BACKUP_TIME=02:00
# Number of backups kept in each place; oldest is removed.
BACKUP_KEEP=30

# --- S3 (or S3-compatible storage), only needed when BACKUP_TARGET is s3 or both ---
S3_BUCKET=
S3_PREFIX=mileage-tracker/
S3_REGION=eu-west-2
# For Backblaze B2, Wasabi, Cloudflare R2, MinIO and other non-AWS endpoints.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_SSE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
